---
/**
 * Il set di icone del sito.
 *
 * Sono icone Lucide ridisegnate inline con i parametri del sistema
 * (`stroke-width: 2.75`, estremi arrotondati). Stanno in un unico file
 * perche' il nome dell'icona arriva dal CMS: la pagina non sa in anticipo
 * quale servira'.
 */
export type NomeIcona =
  | 'tendone' | 'chiesa' | 'bambini' | 'pallone' | 'casa' | 'persone'
  | 'musica' | 'cucina' | 'calendario' | 'orologio' | 'luogo' | 'foglia'
  | 'fiume' | 'stella' | 'regalo' | 'fuoco' | 'libro' | 'pennello'
  | 'gioco' | 'bici' | 'freccia' | 'telefono' | 'posta' | 'mulino' | 'tau';

interface Props {
  nome: NomeIcona;
  dimensione?: number;
  colore?: string;
  class?: string;
}

const { nome, dimensione = 30, colore = 'currentColor', class: classe } = Astro.props;

/** Solo il contenuto del path: viewBox e attributi di tratto sono comuni. */
const TRACCIATI: Record<NomeIcona, string> = {
  tendone: '<path d="M4 11h16"/><path d="M6 11V8a6 6 0 0 1 12 0v3"/><path d="M5 11l1.5 9h11L19 11"/>',
  chiesa: '<path d="M12 3v18"/><path d="M7 8h10"/><path d="M5 21V11l7-5 7 5v10"/>',
  bambini: '<circle cx="12" cy="6" r="3"/><path d="M6 21v-4a6 6 0 0 1 12 0v4"/><path d="M4 13l2-2M20 13l-2-2"/>',
  pallone: '<circle cx="12" cy="12" r="9"/><path d="M12 3l3 5-3 3-3-3 3-5M4 10l4 2M20 10l-4 2M8 20l1-5M16 20l-1-5"/>',
  casa: '<path d="M4 19V8l8-4 8 4v11"/><path d="M9 19v-6h6v6"/>',
  persone: '<circle cx="7" cy="9" r="3"/><circle cx="17" cy="9" r="3"/><path d="M3 20v-2a4 4 0 0 1 8 0v2M13 20v-2a4 4 0 0 1 8 0v2"/>',
  musica: '<path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="17" cy="16" r="3"/>',
  cucina: '<path d="M4 4v7a4 4 0 0 0 8 0V4"/><path d="M8 11v9"/><path d="M18 4c-1.5 2-2 4-2 7v9"/><path d="M16 11h4"/>',
  calendario: '<rect x="3" y="5" width="18" height="16" rx="3"/><path d="M8 3v4M16 3v4M3 11h18"/>',
  orologio: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  luogo: '<path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z"/><circle cx="12" cy="10" r="2.6"/>',
  foglia: '<path d="M4 20c0-9 5-15 16-15 0 11-6 15-13 15H4z"/><path d="M9 16c2-4 5-6 9-7"/>',
  fiume: '<path d="M3 8c3 2 5-1 9 0s6 2 9 0"/><path d="M3 14c3 2 5-1 9 0s6 2 9 0"/><path d="M3 20c3 2 5-1 9 0s6 2 9 0"/>',
  stella: '<path d="M12 3l2.6 6.1 6.4.5-4.9 4.3 1.5 6.4L12 17l-5.6 3.3 1.5-6.4L3 9.6l6.4-.5z"/>',
  regalo: '<rect x="3" y="9" width="18" height="12" rx="2"/><path d="M3 13h18M12 9v12"/><path d="M12 9S9 3 6.5 4.5 9 9 12 9s5.5-3 3-4.5S12 9 12 9z"/>',
  fuoco: '<path d="M12 21a6 6 0 0 0 6-6c0-5-6-10-6-10S6 10 6 15a6 6 0 0 0 6 6z"/><path d="M12 21a2.5 2.5 0 0 0 2.5-2.5c0-2-2.5-4-2.5-4s-2.5 2-2.5 4A2.5 2.5 0 0 0 12 21z"/>',
  libro: '<path d="M4 5a2 2 0 0 1 2-2h13v18H6a2 2 0 0 0-2 2z"/><path d="M4 19a2 2 0 0 1 2-2h13"/>',
  pennello: '<path d="M6 15l-2 5 5-2 9.5-9.5a2.5 2.5 0 0 0-3.5-3.5L5.5 14.5z"/><path d="M14 6l4 4"/>',
  gioco: '<rect x="3" y="7" width="18" height="12" rx="4"/><path d="M8 11v4M6 13h4M16 12h.01M18 15h.01"/>',
  bici: '<circle cx="6" cy="17" r="3.5"/><circle cx="18" cy="17" r="3.5"/><path d="M6 17l4-8h5l3 8M9 6h4"/>',
  freccia: '<path d="M4 12h15"/><path d="M13 6l6 6-6 6"/>',
  telefono: '<path d="M5 3h4l2 5-2.5 1.5a12 12 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2.2 2A17 17 0 0 1 3 5.2 2 2 0 0 1 5 3z"/>',
  posta: '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="M4 7l8 6 8-6"/>',
  mulino: '<circle cx="12" cy="12" r="3"/><path d="M12 9V2M12 15v7M9 12H2M15 12h7M9.5 9.5L4.5 4.5M14.5 14.5l5 5M14.5 9.5l5-5M9.5 14.5l-5 5"/>',
  tau: '<path d="M5 5h14"/><path d="M12 5v16"/>',
};
---

<svg
  width={dimensione}
  height={dimensione}
  viewBox="0 0 24 24"
  fill="none"
  stroke={colore}
  stroke-width="2.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={classe}
  set:html={TRACCIATI[nome] ?? TRACCIATI.stella}
></svg>
