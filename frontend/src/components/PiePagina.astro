---
/**
 * Il footer del sito: identico su tutte le pagine, come chiede l'handoff.
 * I contenuti vengono da `lib/sito.ts`, non dalle singole pagine.
 */
import Marchio from './Marchio.astro';
import { PIE_PAGINA, SITO } from '../lib/sito.ts';
---

<footer class="pie">
  <div class="contenitore pie__griglia">
    <div class="pie__marchio">
      <div class="pie__lockup">
        <Marchio variante="footer" dimensione={38} />
        <span class="pie__nome">{SITO.nome}</span>
      </div>
      <p class="pie__intro">{PIE_PAGINA.intro}</p>
    </div>

    {
      PIE_PAGINA.colonne.map((colonna) => (
        <nav class="pie__colonna" aria-label={colonna.titolo}>
          <span class="pie__titolo">{colonna.titolo}</span>
          {colonna.voci.map((voce) =>
            voce.href ? (
              <a
                href={voce.href}
                {...('esterno' in voce && voce.esterno
                  ? { target: '_blank', rel: 'noopener noreferrer' }
                  : {})}
              >
                {voce.testo}
              </a>
            ) : (
              <span class="pie__voce-muta">{voce.testo}</span>
            ),
          )}
        </nav>
      ))
    }
  </div>

  <div class="contenitore">
    <div class="pie__chiusura">
      <span>
        {PIE_PAGINA.chiusura}{' '}
        <a href={PIE_PAGINA.chiusuraAutore.href} target="_blank" rel="noopener noreferrer">
          {PIE_PAGINA.chiusuraAutore.testo}
        </a>
      </span>
      <span>{PIE_PAGINA.social}</span>
    </div>
  </div>
</footer>

<style>
  .pie {
    margin-top: 96px;
    background: var(--color-neutral-900);
    color: var(--color-neutral-200);
  }
  .pie__griglia {
    padding-top: 62px;
    padding-bottom: 34px;
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 40px;
  }
  .pie__marchio { display: flex; flex-direction: column; gap: 14px; }
  .pie__lockup { display: flex; align-items: center; gap: 12px; }
  .pie__nome {
    font-family: var(--font-heading);
    font-size: 22px;
    color: var(--color-neutral-100);
  }
  .pie__intro { font-size: 14.5px; line-height: 1.6; opacity: 0.8; max-width: 40ch; margin: 0; }

  .pie__colonna { display: flex; flex-direction: column; gap: 10px; font-size: 14.5px; }
  .pie__titolo {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--color-accent-300);
  }
  .pie__colonna a { color: var(--color-neutral-200); }
  .pie__colonna a:hover { color: #fff; }
  .pie__voce-muta { opacity: 0.85; }

  .pie__chiusura {
    border-top: 1px solid rgba(249, 244, 237, 0.16);
    padding-top: 22px;
    padding-bottom: 46px;
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    justify-content: space-between;
    font-size: 13.5px;
    opacity: 0.72;
  }
  .pie__chiusura a { color: inherit; text-decoration: underline; }
  .pie__chiusura a:hover { color: #fff; }

  @media (max-width: 900px) { .pie__griglia { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .pie__griglia { grid-template-columns: 1fr; gap: 30px; } }
</style>
