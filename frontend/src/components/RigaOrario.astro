---
/**
 * Una riga oraria: disco icona, ora in Caprasimo, titolo e nota.
 *
 * E' la riga del programma della sagra e, con `compatta`, quella della
 * giornata tipo del Grest.
 *
 * Gli appuntamenti «in risalto» diventano un blocco pieno: la tinta arriva
 * dal CMS (`Evento.tono`), cosi' la serata dei video del Grest puo' essere
 * azzurra mentre il resto della sagra resta terracotta.
 */
import DiscoIcona from './DiscoIcona.astro';
import type { NomeIcona } from './Icona.astro';
import { tono as leggiTono } from '../lib/toni.ts';

interface Props {
  ora: string;
  titolo: string;
  nota?: string;
  piatto?: string;
  icona?: NomeIcona;
  tonoIcona?: string;
  /** Riga a blocco pieno: il momento speciale della giornata. */
  risalto?: boolean;
  /** Tono del blocco in risalto, dal CMS. Vuoto = salvia scura, come prima. */
  tono?: string;
  /** Se l'evento ha una pagina dedicata la riga diventa un link. */
  href?: string;
  esterno?: boolean;
}

const {
  ora,
  titolo,
  nota,
  piatto,
  icona,
  tonoIcona = 'accent-200',
  risalto = false,
  tono,
  href,
  esterno = false,
} = Astro.props;

const tinta = leggiTono(tono || 'accent-2-700');

// Nel blocco pieno il disco prende il gradino chiaro della stessa famiglia.
const tonoDisco = risalto ? (tono || 'accent-2-600') : tonoIcona;

const stile = risalto
  ? `background:${tinta.sfondo};color:${tinta.inchiostro};--riga-tenue:${tinta.tenue}`
  : undefined;

const Elemento = href ? 'a' : 'div';
const attributi = href
  ? { href, ...(esterno ? { target: '_blank', rel: 'noopener noreferrer' } : {}) }
  : {};
---

<Elemento
  class={`riga-orario ${risalto ? 'riga-orario--risalto' : ''} ${href ? 'riga-orario--link' : ''}`.trim()}
  style={stile}
  {...attributi}
>
  {icona && <DiscoIcona icona={icona} tono={tonoDisco} dimensione={42} />}
  <span class="riga-orario__ora">{ora}</span>
  <div class="riga-orario__testo">
    <strong>{titolo}</strong>
    {piatto && <span class="riga-orario__piatto">{piatto}</span>}
    {nota && <span class="riga-orario__nota">{nota}</span>}
    {href && <span class="riga-orario__freccia">Leggi tutto →</span>}
  </div>
</Elemento>

<style>
  .riga-orario {
    display: grid;
    grid-template-columns: 42px 58px 1fr;
    gap: 14px;
    align-items: start;
    text-decoration: none;
    color: inherit;
  }
  .riga-orario__ora {
    font-family: var(--font-heading);
    font-size: 17px;
    line-height: 1.35;
    color: var(--color-accent-700);
  }
  .riga-orario__testo { display: flex; flex-direction: column; gap: 3px; }
  .riga-orario__testo strong { font-size: 16.5px; font-weight: 700; line-height: 1.35; }
  /* Il piatto del giorno e' l'informazione che la gente cerca per prima. */
  .riga-orario__piatto { font-size: 15px; font-weight: 700; color: var(--color-accent-2-700); }
  .riga-orario__nota { font-size: 14.5px; line-height: 1.5; color: var(--color-neutral-700); }
  .riga-orario__freccia {
    font-size: 13.5px;
    font-weight: 700;
    margin-top: 3px;
    color: var(--color-accent-700);
  }
  a.riga-orario:hover .riga-orario__testo strong { text-decoration: underline; }

  .riga-orario--risalto {
    grid-column: 1 / -1;
    padding: 16px 18px;
    border-radius: var(--radius-md);
  }
  /* Dentro al blocco pieno tutto il testo vive sul fondo colorato: i toni
     secondari arrivano dalla variabile impostata sopra. */
  .riga-orario--risalto .riga-orario__ora,
  .riga-orario--risalto .riga-orario__piatto,
  .riga-orario--risalto .riga-orario__freccia { color: var(--riga-tenue); }
  .riga-orario--risalto .riga-orario__nota { color: inherit; opacity: 0.86; }

  @media (max-width: 520px) {
    .riga-orario { grid-template-columns: 34px 52px 1fr; gap: 10px; }
  }
</style>
