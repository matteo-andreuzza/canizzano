---
/**
 * La riga della giornata tipo del Grest: ora larga a sinistra, titolo e
 * spiegazione a destra. Il momento centrale della giornata e' colorato.
 */
interface Props {
  ora: string;
  titolo: string;
  testo: string;
  risalto?: boolean;
}
const { ora, titolo, testo, risalto = false } = Astro.props;
---

<div class={`giorno ${risalto ? 'giorno--risalto' : ''}`.trim()}>
  <span class="giorno__ora">{ora}</span>
  <div class="giorno__testo">
    <strong>{titolo}</strong>
    <span>{testo}</span>
  </div>
</div>

<style>
  .giorno {
    display: grid;
    grid-template-columns: 78px 1fr;
    gap: 18px;
    align-items: center;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: 20px 24px;
  }
  .giorno__ora { font-family: var(--font-heading); font-size: 22px; color: var(--color-accent-700); }
  .giorno__testo { display: flex; flex-direction: column; gap: 3px; }
  .giorno__testo strong { font-size: 17.5px; }
  .giorno__testo span { font-size: 14.5px; line-height: 1.5; color: var(--color-neutral-800); }

  .giorno--risalto { background: var(--color-accent-2-600); color: #fbfff2; }
  .giorno--risalto .giorno__ora { color: var(--color-accent-300); }
  .giorno--risalto .giorno__testo span { color: inherit; opacity: 0.92; }

  @media (max-width: 520px) { .giorno { grid-template-columns: 62px 1fr; gap: 12px; padding: 18px; } }
</style>
