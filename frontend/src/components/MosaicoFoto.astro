---
/**
 * Il mosaico fotografico delle raccolte: una foto grande, alcune piccole e
 * qualche cerchio, secondo lo schema dei prototipi.
 *
 * Le foto arrivano dal CMS; lo schema si ripete se ce ne sono di piu' e si
 * accorcia se ce ne sono di meno.
 */
import Foto from './Foto.astro';
import type { Foto as FotoCms } from '../lib/contenuti.ts';

interface Props {
  foto: FotoCms[];
  /** Numero di riquadri dello schema, se non ci sono abbastanza foto. */
  minimo?: number;
}
const { foto, minimo = 6 } = Astro.props;

/** Lo schema del mosaico: dimensione della cella e forma. */
const SCHEMA = [
  { classe: 'mosaico__grande', forma: 'rettangolo' as const },
  { classe: '', forma: 'rettangolo' as const },
  { classe: '', forma: 'rettangolo' as const },
  { classe: 'mosaico__cerchio', forma: 'cerchio' as const },
  { classe: 'mosaico__largo', forma: 'rettangolo' as const },
  { classe: 'mosaico__cerchio', forma: 'cerchio' as const },
];

const celle = Array.from({ length: Math.max(foto.length, minimo) }, (_, indice) => ({
  ...SCHEMA[indice % SCHEMA.length],
  foto: foto[indice],
}));
---

<div class="mosaico">
  {
    celle.map((cella) => (
      <div class={cella.classe}>
        <Foto
          src={cella.foto?.immagine}
          alt={cella.foto?.testo_alternativo ?? cella.foto?.didascalia ?? ''}
          attesa={cella.foto?.didascalia ?? 'Foto del quartiere da caricare'}
          altezza="100%"
          forma={cella.forma}
        />
      </div>
    ))
  }
</div>

<style>
  .mosaico {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 190px;
    gap: 20px;
  }
  .mosaico > div { min-height: 0; }
  .mosaico__grande { grid-column: span 2; grid-row: span 2; }
  .mosaico__largo { grid-column: span 2; }
  .mosaico__cerchio { display: grid; place-items: center; }
  /* Il cerchio non deve mai deformarsi: sta dentro il quadrato della cella. */
  .mosaico__cerchio :global(.foto) { width: 190px; height: 190px !important; }

  @media (max-width: 900px) { .mosaico { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) {
    .mosaico { grid-template-columns: 1fr; }
    .mosaico__grande, .mosaico__largo { grid-column: span 1; grid-row: span 1; }
  }
</style>
