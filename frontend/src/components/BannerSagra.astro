---
/**
 * Il richiamo all'appuntamento del momento: fascia terracotta con occhiello,
 * titolo e bottone.
 *
 * Non e' legato alla sagra: testo e destinazione arrivano dall'admin, cosi'
 * lo stesso spazio in cima alla home puo' annunciare la sagra a settembre,
 * le iscrizioni al Grest a giugno o quelle al catechismo a ottobre. Compare
 * anche in cima alla pagina Pro Loco durante la «modalita' sagra».
 */
import Bottone from './Bottone.astro';
import { ROTTE } from '../lib/sito.ts';

interface Props {
  occhiello?: string;
  titolo: string;
  testo?: string;
  /** Vuoto o assente: si torna ai valori di ripiego (programma della sagra). */
  etichettaBottone?: string;
  href?: string;
}
const { occhiello, titolo, testo, etichettaBottone, href } = Astro.props;

// I campi dell'admin arrivano come stringhe vuote quando la redazione non li
// compila: li trattiamo come «non impostati».
const destinazione = href?.trim() || ROTTE.sagra;
const etichetta = etichettaBottone?.trim() || 'Vai al programma';
// Un indirizzo completo esce dal sito: il bottone apre in una nuova scheda.
const esterno = /^https?:\/\//i.test(destinazione);
---

<div class="banner">
  <div class="banner__testo">
    {occhiello && <span class="occhiello banner__occhiello">{occhiello}</span>}
    <h2>{titolo}</h2>
    {testo && <p>{testo}</p>}
  </div>
  <Bottone href={destinazione} variante="chiaro" esterno={esterno}>{etichetta}</Bottone>
</div>

<style>
  .banner {
    background: var(--color-accent);
    border-radius: var(--radius-lg);
    padding: 34px 40px;
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
    align-items: center;
    justify-content: space-between;
    box-shadow: var(--shadow-md);
  }
  .banner__testo { display: flex; flex-direction: column; gap: 8px; color: #fff2eb; }
  .banner__occhiello { color: var(--color-accent-200); }
  .banner h2 { font-size: 40px; line-height: 1.02; margin: 0; }
  .banner p { font-size: 16px; opacity: 0.92; margin: 0; }

  @media (max-width: 900px) {
    .banner { padding: 28px; }
    .banner h2 { font-size: 30px; }
  }
</style>
