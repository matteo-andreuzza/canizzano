# ─────────────────────────────────────────────────────────────────────────────
#  canizzano.it — configurazione locale
#  Copia questo file in «.env» e compila i valori. Il .env NON va su git.
# ─────────────────────────────────────────────────────────────────────────────

# --- Sito --------------------------------------------------------------------
SITE_NAME=Canizzano
# Dominio finale: serve ad Astro per sitemap e URL assolute.
SITE_BASE_URL=https://canizzano.it

# --- Django / CMS ------------------------------------------------------------
# Genera una chiave nuova con:  ./canizzano.sh chiave
DJANGO_SECRET_KEY=cambiami-con-una-chiave-generata
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CMS_PORT=8000
GUNICORN_WORKERS=3
TZ=Europe/Rome

# Utenza di redazione creata al primo avvio.
DJANGO_SUPERUSER_USERNAME=redazione
DJANGO_SUPERUSER_PASSWORD=cambia-questa-password
DJANGO_SUPERUSER_EMAIL=info@canizzano.it

# Metti a "true" per popolare il CMS con eventi d'esempio al primo avvio.
CARICA_DATI_ESEMPIO=false

# --- Assistente AI (server MCP su /mcp/) -------------------------------------
# La chiave con cui l'agente si collega NON sta qui: si crea e si revoca
# dall'admin, in «Assistente AI → chiavi dell'assistente». La vedi anche con
#   ./canizzano.sh mcp
#
# Da compilare solo se esponi il CMS fuori di casa (un tunnel, un dominio):
# è l'indirizzo che compare nelle istruzioni di collegamento. Ricordati di
# aggiungere lo stesso host a DJANGO_ALLOWED_HOSTS qui sopra.
MCP_URL_PUBBLICO=
# Quanto può pesare una richiesta (le locandine viaggiano dentro la chiamata).
MCP_MAX_CORPO_MB=32

# --- Dashboard della redazione (:8000/riservata/) ----------------------------
# Indirizzo della pagina delle chiavi AI dell'altro progetto Django (MCP): la
# dashboard ci mette un collegamento, così la chiave da dare a Claude Code si
# copia da lì senza passaggi intermedi. Finché resta il segnaposto, la pagina
# lo segnala da sola.
AI_KEYS_ADMIN_URL=https://TODO-verrà-fornito/

# --- Bot del foglietto parrocchiale (repository «canizzano-mcp») ------------
# Scarica il foglietto, lo legge con Gemini e scrive eventi e articoli nel
# CMS. Vive nel suo repository, nel suo container Docker, sempre acceso: le
# righe qui sotto servono solo a dare alla dashboard il bottone «Elabora il
# foglietto», per farlo partire subito invece di aspettare lo scheduler
# interno del bot (sabato mattina).
#
# Indirizzo del suo endpoint /attiva sulla rete Docker condivisa (nome del
# servizio nel compose.yaml di quel repository, non "localhost": i due stack
# sono due progetti compose separati). Lascialo vuoto se il bot non c'è o non
# ti serve: il bottone semplicemente non compare.
# BOT_FOGLIETTO_URL=http://bot:8088/attiva
#
# Token condiviso: deve comparire IDENTICO nel .env di questo repository e in
# quello del bot (lì si chiama ATTIVA_TOKEN). Generane uno con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# BOT_FOGLIETTO_TOKEN=
#
# Quanto aspettare la risposta dell'endpoint (secondi): risponde subito
# («occupato» o «libero»), non il tempo di tutta l'elaborazione — non serve
# alzarlo, di norma non serve toccarlo.
# TIMEOUT_FOGLIETTO=10
#
# Nome della rete Docker esterna condivisa fra i due stack. Va creata una
# tantum (`docker network create <nome>`) e comparire IDENTICA anche nel .env
# del bot.
NOME_RETE_CONDIVISA=canizzano_rete

# --- Adattamento alla macchina (di norma NON serve toccare niente) ------------
# Percorso del progetto, utente proprietario e gruppo del socket Docker si
# ricavano da soli a ogni avvio: lo stesso repo gira su un portatile, su un
# Raspberry Pi o su un server senza modifiche. Le righe qui sotto servono solo
# alle macchine fuori standard — lasciale commentate finché non servono.
#
# Docker rootless tiene il socket altrove (di solito in /run/user/<uid>/):
# DOCKER_SOCKET=/run/user/1000/docker.sock
#
# Per intestare i file generati a un utente diverso da chi lancia lo script:
# UID_HOST=1000
# GID_HOST=1000
#
# Tetti di tempo dei comandi lanciati dalla dashboard, in secondi. Su una
# macchina lenta (Raspberry Pi, poca RAM) un build può volerci parecchio:
# TIMEOUT_AVVIA=1800
# TIMEOUT_DEV=1800
# TIMEOUT_TUTTO=7200

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=canizzano
POSTGRES_USER=canizzano
POSTGRES_PASSWORD=cambia-questa-password-db
POSTGRES_PORT=5432

# --- Astro (dev) -------------------------------------------------------------
DEV_PORT=4321

# --- Pubblicazione FTP sull'hosting statico ----------------------------------
FTP_HOST=ftp.canizzano.it
FTP_PORT=21
FTP_USER=utente-ftp
FTP_PASSWORD=password-ftp
# Cartella pubblica dell'hosting (spesso /, /htdocs, /public_html o /www).
FTP_REMOTE_DIR=/
# "ftp" (con TLS se il server lo offre) oppure "ftps" per imporlo.
FTP_PROTOCOLLO=ftp
FTP_PASSIVO=true
# Metti a "false" solo se l'hosting usa un certificato self-signed.
FTP_VERIFICA_CERTIFICATO=true
FTP_TRASFERIMENTI_PARALLELI=4
